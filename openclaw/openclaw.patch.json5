{
  agents: {
    defaults: {
      skipBootstrap: true,
      timeoutSeconds: 600,
    },
    entries: {
      "opsswarm-incident-manager": { workspace: "C:/MyFolder/Hoc_Tap/project/Minto/OpsSwarm-IncidentLab/openclaw/workspaces/opsswarm-incident-manager" },
      "opsswarm-observability-investigator": { workspace: "C:/MyFolder/Hoc_Tap/project/Minto/OpsSwarm-IncidentLab/openclaw/workspaces/opsswarm-observability-investigator" },
      "opsswarm-application-investigator": { workspace: "C:/MyFolder/Hoc_Tap/project/Minto/OpsSwarm-IncidentLab/openclaw/workspaces/opsswarm-application-investigator" },
      "opsswarm-infrastructure-investigator": { workspace: "C:/MyFolder/Hoc_Tap/project/Minto/OpsSwarm-IncidentLab/openclaw/workspaces/opsswarm-infrastructure-investigator" },
      "opsswarm-database-investigator": { workspace: "C:/MyFolder/Hoc_Tap/project/Minto/OpsSwarm-IncidentLab/openclaw/workspaces/opsswarm-database-investigator" },
      "opsswarm-recovery-responder": { workspace: "C:/MyFolder/Hoc_Tap/project/Minto/OpsSwarm-IncidentLab/openclaw/workspaces/opsswarm-recovery-responder" },
      "opsswarm-communications-postmortem": { workspace: "C:/MyFolder/Hoc_Tap/project/Minto/OpsSwarm-IncidentLab/openclaw/workspaces/opsswarm-communications-postmortem" }
    }
  },
  skills: {
    load: {
      extraDirs: ["C:/MyFolder/Hoc_Tap/project/Minto/OpsSwarm-IncidentLab/skills-enterprise"]
    }
  },
  plugins: {
    entries: {
      codex: {
        enabled: true,
        config: {
          appServer: {
            homeScope: "user",
            command: "C:/Users/nguye/AppData/Roaming/npm/codex.cmd"
          }
        }
      }
    }
  },
  gateway: {
    mode: "local",
    bind: "lan",
    port: 18789,
    http: { endpoints: { responses: { enabled: true } } }
  },
}


