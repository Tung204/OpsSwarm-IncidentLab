INCIDENTLAB_PUBLIC_URL=http://localhost:8080
# External OpsSwarm-Enterprise monitoring ingress. IncidentLab remains usable if unavailable.
INCIDENTLAB_MONITORING_URL=http://host.docker.internal:18088/hooks/monitoring
# Shared only with the trusted Enterprise recovery executor/profile. Required for all recovery writes.
INCIDENTLAB_CONTROL_TOKEN=replace-with-a-long-random-secret
